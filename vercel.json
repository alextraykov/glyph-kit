{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node site/build.mjs",
  "outputDirectory": "site/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "missing": [
        {
          "type": "host",
          "value": "glyph-kit.traykov.cc"
        }
      ],
      "destination": "/glyph-kit/",
      "permanent": false
    },
    {
      "source": "/glyph-kit",
      "has": [
        {
          "type": "host",
          "value": "glyph-kit.traykov.cc"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/glyph-kit/:path([^.]*)",
      "has": [
        {
          "type": "host",
          "value": "glyph-kit.traykov.cc"
        }
      ],
      "destination": "/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "glyph-kit.traykov.cc"
        }
      ],
      "destination": "/glyph-kit/"
    },
    {
      "source": "/:path(.+)/",
      "has": [
        {
          "type": "host",
          "value": "glyph-kit.traykov.cc"
        }
      ],
      "destination": "/glyph-kit/:path/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "glyph-kit.traykov.cc"
        }
      ],
      "destination": "/glyph-kit/:path*"
    }
  ]
}
