{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node site/build.mjs",
  "outputDirectory": "site/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/glyph-kit/kinds{/}?",
      "destination": "/types/",
      "permanent": true
    },
    {
      "source": "/kinds{/}?",
      "destination": "/types/",
      "permanent": true
    },
    {
      "source": "/glyph-kit",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/glyph-kit/:path(.*)",
      "destination": "/:path",
      "permanent": true
    }
  ]
}
