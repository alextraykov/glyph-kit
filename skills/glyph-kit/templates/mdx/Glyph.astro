---
// Glyph kit figure for Astro MDX. Renders the spec to a crisp SVG at build time; no client JavaScript.
// Copy next to your MDX and point GLYPH_KIT at where you keep the skill's scripts folder.
// Usage in MDX:  import Glyph from "./Glyph.astro";   <Glyph theme="paper" spec={{ kind: "funnel", … }} />
import { renderSvg } from "../../scripts/render/svg.mjs"; // ← adjust to your copy of glyph-kit/scripts

interface Props {
  spec: Record<string, unknown>;
  theme?: "paper" | "ink" | "phosphor" | "gilt";
  frame?: boolean;
}
const { spec, theme = "paper", frame = true } = Astro.props;
const svg = renderSvg(spec as never, { theme, frame });
---
<figure class="glyph-figure" set:html={svg} />
<style>
  .glyph-figure { margin: 2rem 0; overflow-x: auto; }
  .glyph-figure :global(svg) { display: block; max-width: 100%; height: auto; }
</style>
