{
  "name": "Your design system",
  "about": "Copy this file into your project as design-system.map.json and replace the right-hand sides with your own names. Glyph kit uses the tokens to style HTML prototypes and decks; agents use the components and motion entries to build production code with your real parts. Give every token a fallback, var(--your-token, #value), so prototypes also render outside your project. Set \"stylesheet\" to load your design system's CSS into prototypes and decks.",
  "stylesheet": "",
  "tokens": {
    "ink": "var(--color-text, #111110)",
    "surface": "var(--color-background, #ffffff)",
    "panel": "var(--color-surface-subtle, #f4f4f2)",
    "muted": "var(--color-text-secondary, #6b6b66)",
    "line": "var(--color-border, #d6d6cf)",
    "accent": "var(--color-primary, #1f4fd6)",
    "onAccent": "var(--color-on-primary, #ffffff)",
    "danger": "var(--color-danger, #b8421f)",
    "space": "var(--space-2, 8px)",
    "radius": "var(--radius-md, 6px)",
    "font": "var(--font-body, system-ui, sans-serif)",
    "mono": "var(--font-mono, Menlo, monospace)",
    "durationBase": "var(--duration-base, 200ms)",
    "easingBase": "var(--ease-standard, cubic-bezier(0.2, 0, 0, 1))",
    "ok": "var(--color-success, #0a7a50)"
  },
  "components": {
